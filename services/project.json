{
  "name": "@ankaui-framework/services",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "dependsOn": [
          {
            "target": "build",
            "dependencies": true
          }
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "services/ng-package.json",
        "tsConfig": "libs/services/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "services/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "services/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"      
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "services/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
