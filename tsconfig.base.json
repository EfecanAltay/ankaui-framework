{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": "./",
    "types": ["jest", "node"],
    "paths": {
      "@ankaui-framework/components": ["components/src/index.ts"],
      "@ankaui-framework/data": ["data/src/index.ts"],
      "@ankaui-framework/middlewares": ["middlewares/src/index.ts"],
      "@ankaui-framework/services": ["services/src/index.ts"],
      "crypto": ["node_modules/crypto"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
